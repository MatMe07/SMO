<Window x:Class="SMO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMO"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu >
            <MenuItem Header="Одноканальные СМО">
                <MenuItem Header="Одноканальная СМО с отказами в обслуживании" Click="MenuItem_Click" Tag="Odno_s_otkaz"/>
                <MenuItem Header="Одноканальная СМО с ограниченной длиной очереди" Click="MenuItem_Click" Tag="Odno_s_ogranich"/>
                <MenuItem Header="Одноканальная СМО с неограниченной очередью"  Click="MenuItem_Click" Tag="Odno_s_neogra"/>
            </MenuItem>
            <MenuItem Header="Многоканальные СМО">
                <MenuItem Header="Многоканальная СМО с отказами в обслуживании" Click="MenuItem_Click" Tag="Mnogo_s_otkaz"/>
                <MenuItem Header="Многоканальная СМО с ограниченной длиной очереди" Click="MenuItem_Click" Tag="Mnogo_s_ogranich"/>
                <MenuItem Header="Многоканальная СМО с неограниченной очередью" Click="MenuItem_Click" Tag="Mnogo_s_neogra"/>
            </MenuItem>
        </Menu>
        <Frame Grid.Row="1" Name="mainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
